# Copia este archivo como .env.local y llena los valores de Firebase Console
# (Configuración del proyecto → Tus apps → app web → firebaseConfig).
# .env.local NO se sube a GitHub (ya está en el .gitignore de Expo).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# T-29: cuenta docente "Equipo DocenGo" con la que scripts/cargar-lugares.mjs carga los lugares
# reales (npm run cargar:lugares). Escríbela solo en .env.local, nunca en este archivo.
CARGA_CORREO=
CARGA_CONTRASENA=
