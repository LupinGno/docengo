rules_version = '2';

// Reglas de seguridad de DocenGo. Copiar en Firebase Console → Firestore → Reglas → Publicar.
// - Solo usuarios con sesión pueden leer.
// - Cada quien solo crea contenido a su nombre (autorId = su uid).
// - Solo el autor o un admin pueden editar o borrar (RF-29, RF-45).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function esAdmin() {
      return autenticado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    function esAutor() {
      return autenticado() && resource.data.autorId == request.auth.uid;
    }
    function creaASuNombre() {
      return autenticado() && request.resource.data.autorId == request.auth.uid;
    }

    // Perfiles: nadie puede darse el rol de admin a sí mismo
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create: if autenticado() && request.auth.uid == uid
                    && request.resource.data.rol == 'docente';
      allow update: if (autenticado() && request.auth.uid == uid
                        && request.resource.data.rol == resource.data.rol)
                    || esAdmin();
      allow delete: if (autenticado() && request.auth.uid == uid) || esAdmin();
    }

    // puntos, servicios, mensajes, alertas, hospedajes, lugares, paradas
    match /{coleccion}/{id} {
      allow read: if autenticado();
      allow create: if creaASuNombre();
      allow update, delete: if esAutor() || esAdmin();
    }

    // Para RF-34 (confirmar/desmentir alertas) Carlos agregará aquí:
    // match /alertas/{alertaId}/votos/{uid} { ... }
  }
}
