rules_version = '2';

// Reglas de seguridad de DocenGo. Copiar en Firebase Console → Firestore → Reglas → Publicar.
// - Solo usuarios con sesión pueden leer.
// - Cada quien solo crea contenido a su nombre (autorId = su uid).
// - Solo el autor o un admin pueden editar o borrar (RF-29, RF-45).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function esAdmin() {
      return autenticado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    function esAutor() {
      return autenticado() && resource.data.autorId == request.auth.uid;
    }
    function creaASuNombre() {
      return autenticado() && request.resource.data.autorId == request.auth.uid;
    }

    // Perfiles: nadie puede darse el rol de admin a sí mismo.
    // Privados (RNF-05, T-28 S8): incluyen el correo, así que solo los lee su dueño o un admin.
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if autenticado() && request.auth.uid == uid
                    && request.resource.data.rol == 'docente';
      allow update: if (autenticado() && request.auth.uid == uid
                        && request.resource.data.rol == resource.data.rol)
                    || esAdmin();
      allow delete: if (autenticado() && request.auth.uid == uid) || esAdmin();
    }

    // Colecciones con su propio bloque abajo. Se excluyen de la regla genérica porque
    // Firestore suma las reglas con OR: sin la exclusión, la genérica las dejaría pasar.
    function tieneBloquePropio(coleccion) {
      // 'usuarios' también: sin esto la genérica dejaba crear un perfil con rol admin (hallazgo H11, T-00).
      return coleccion in ['usuarios', 'reportes', 'lugares', 'mensajes', 'avisos'];
    }

    // puntos, servicios, alertas, hospedajes, paradas
    match /{coleccion}/{id} {
      allow read: if !tieneBloquePropio(coleccion) && autenticado();
      allow create: if !tieneBloquePropio(coleccion) && creaASuNombre();
      allow update, delete: if !tieneBloquePropio(coleccion) && (esAutor() || esAdmin());
    }

    // RF-20 a RF-22: mensajes del chat (T-28, S6 y S7). Mismas listas que src/lib/salas.ts
    // (REGIONES, TEMAS, MAX_MENSAJE). Los mensajes no se editan; el autor o un admin los borra.
    function mensajeValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['texto', 'sala', 'region', 'tema', 'autorId', 'autorNombre', 'fecha', 'respuestaA'])
        && d.texto is string && d.texto.trim().size() > 0 && d.texto.size() <= 1000
        && d.region in ['Yuriria', 'Uriangato', 'Moroleón']
        && d.tema in ['General', 'Escuela', 'Ambiente laboral', 'Servicios básicos', 'Institucional']
        && d.sala is string && d.sala.size() <= 60
        && d.autorNombre is string && d.autorNombre.size() <= 60
        && d.fecha is number
        && (!('respuestaA' in d) || d.respuestaA is map);
    }

    match /mensajes/{mensajeId} {
      allow read: if autenticado();
      allow create: if creaASuNombre() && mensajeValido();
      allow update: if esAdmin();
      allow delete: if esAutor() || esAdmin();
    }

    // RF-24: salas y token push de cada docente (T-28, S8). Id = uid.
    // Se separan de "usuarios" porque quien envía un mensaje necesita leer los de los demás.
    match /avisos/{uid} {
      allow read: if autenticado();
      allow create, update: if autenticado() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['salas', 'pushToken'])
                            && (!('salas' in request.resource.data)
                                || (request.resource.data.salas is list && request.resource.data.salas.size() <= 15))
                            && (!('pushToken' in request.resource.data)
                                || (request.resource.data.pushToken is string && request.resource.data.pushToken.size() <= 200));
      allow delete: if (autenticado() && request.auth.uid == uid) || esAdmin();
    }

    // RF-26: mismas validaciones que src/lib/lugares.ts (CATEGORIAS_LUGAR, REGIONES, MAX_NOMBRE, MAX_DESCRIPCION)
    function lugarValido() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.trim().size() > 0 && d.nombre.size() <= 60
        && d.categoria in ['Comida', 'Cafetería', 'Parque o recreación', 'Cultura', 'Compras', 'Otro']
        && d.localidad in ['Yuriria', 'Uriangato', 'Moroleón']
        && d.descripcion is string && d.descripcion.trim().size() > 0 && d.descripcion.size() <= 300
        && d.latitud is number && d.longitud is number;
    }

    // RF-26 a RF-29: lugares destacados. Solo el autor edita o elimina (o un admin, RF-45),
    // y al editar no puede cambiar autorId.
    match /lugares/{lugarId} {
      allow read: if autenticado();
      allow create: if creaASuNombre() && lugarValido();
      allow update: if (esAutor() && lugarValido() && request.resource.data.autorId == resource.data.autorId)
                    || esAdmin();
      allow delete: if esAutor() || esAdmin();

      // RF-28: id = uid de quien valora → una valoración por persona; valorar otra vez la reemplaza.
      // El autor no puede valorar su propio lugar. Mismas validaciones que src/lib/valoraciones.ts.
      match /valoraciones/{uid} {
        allow read: if autenticado();
        allow create, update: if autenticado() && request.auth.uid == uid
                              && request.resource.data.autorId == uid
                              && request.resource.data.estrellas is int
                              && request.resource.data.estrellas >= 1
                              && request.resource.data.estrellas <= 5
                              && request.resource.data.comentario is string
                              && request.resource.data.comentario.size() <= 300
                              && get(/databases/$(database)/documents/lugares/$(lugarId)).data.autorId != uid;
        allow delete: if (autenticado() && request.auth.uid == uid) || esAdmin();
      }
    }

    // RF-25: reportes de mensajes. Id = "<idMensaje>_<uid>" → un reporte por persona por mensaje.
    // Quien reporta solo puede consultar el suyo; nadie más que el admin los lista ni los modifica.
    match /reportes/{reporteId} {
      allow get: if esAdmin()
                 || (autenticado() && (resource == null || resource.data.autorId == request.auth.uid));
      allow list: if esAdmin();
      allow create: if creaASuNombre()
                    && reporteId == request.resource.data.contenidoId + '_' + request.auth.uid
                    && request.resource.data.estado == 'pendiente'
                    // mismas validaciones que src/lib/reportes.ts (MOTIVOS y MAX_DETALLE)
                    && request.resource.data.motivo in ['Spam', 'Ofensivo o acoso', 'Información falsa', 'Datos personales', 'Otro']
                    && request.resource.data.detalle.size() <= 300;
      allow update, delete: if esAdmin();
    }

    // RF-42: cualquier docente actualiza solo los horarios de una parada (T-17).
    // El resto de la parada lo cambia su autor o un admin (regla genérica).
    match /paradas/{id} {
      allow update: if autenticado()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['horarios', 'duracionMin', 'actualizadoPor', 'actualizado']);
    }

    // RF-34: confirmar/desmentir alertas (T-06).
    // Un voto por docente (el id del documento es su uid) y el autor no vota su alerta.
    match /alertas/{alertaId}/votos/{uid} {
      function esSuVoto() {
        return autenticado() && request.auth.uid == uid;
      }
      function noEsAutor() {
        return get(/databases/$(database)/documents/alertas/$(alertaId)).data.autorId != request.auth.uid;
      }
      function votoValido() {
        return request.resource.data.keys().hasOnly(['voto', 'fecha'])
          && request.resource.data.voto in ['confirma', 'desmiente']
          && request.resource.data.fecha is int;
      }
      allow read: if autenticado();
      allow create, update: if esSuVoto() && noEsAutor() && votoValido();
      allow delete: if esSuVoto() || esAdmin();
    }
  }
}
